GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RPM=20
PYTHONDONTWRITEBYTECODE=1

# Supabase Postgres — pick ONE approach:
#
# Option A (URI): Project Settings -> Database -> Connection string -> URI
# Use the DATABASE password (reset under Database Settings). Not the anon/service API key.
# If password has special characters (@ # %), use Option B instead.
# If direct connection times out, use the *Session pooler* URI from the same page.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Option B (recommended when password has @ # % etc.):
# SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
#
# Session pooler example (if direct connection times out):
# SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_DB_PORT=5432

# Optional source API credentials
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=startup-analyzer/1.0
PRODUCT_HUNT_TOKEN=

# Analyzer settings
ANALYZER_MAX_DEPTH=4
ANALYZER_QUERIES_PER_SOURCE=5
ANALYZER_EXTRACTION_BATCH=8
ANALYZER_SEARCH_WORKERS=8
ANALYZER_EXTRACTION_WORKERS=3
ANALYZER_FLUSH_DB_AFTER_RUN=true
